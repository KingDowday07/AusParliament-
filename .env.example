# Copy to .env.local (ignored by git) and fill in real values.
# Nothing in this file is a real secret — it's a reference for what the
# project needs once the blocked infrastructure items are provisioned.

# --- Postgres (packages/db, packages/monitor) --------------------------
# Connection string for a provisioned Postgres instance (e.g. Neon).
# Required by packages/db/src/client.ts getDb(), packages/db/drizzle.config.ts,
# and the packages/monitor/src/jobs/*.ts scheduled jobs.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Sentry (apps/web) ---------------------------------------------------
# From your Sentry project settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: only needed for uploading source maps on build (Sentry org/project auth token).
SENTRY_AUTH_TOKEN=
